# Skopíruj na config/secrets.yaml a vyplň skutočné hodnoty.
# Tento súbor nie je verzovaný, aby heslo neskončilo v gite.
#
#   cp config/secrets.yaml.example config/secrets.yaml
#   chmod 600 config/secrets.yaml
#
# Hodnoty prepisujú database v settings.yaml. Prostredie má prednosť pred
# oboma: EJECTOR_DB_HOST, EJECTOR_DB_PORT, EJECTOR_DB_USER,
# EJECTOR_DB_PASSWORD, EJECTOR_DB_NAME.

database:
  user: dbapp
  password: zmen-ma
