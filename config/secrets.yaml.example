# Skopíruj na config/secrets.yaml a vyplň skutočné hodnoty.
# Tento súbor nie je verzovaný, aby heslo neskončilo v gite.
#
#   cp config/secrets.yaml.example config/secrets.yaml
#   chmod 600 config/secrets.yaml
#
# Hodnoty prepisujú database v settings.yaml. Prostredie má prednosť pred
# oboma: EJECTOR_DB_HOST, EJECTOR_DB_PORT, EJECTOR_DB_USER,
# EJECTOR_DB_PASSWORD, EJECTOR_DB_NAME.
#
# Alarmové maily čítajú sekciu smtp. Príjemcovia sú v config/emails.yaml.

database:
  user: dbapp
  password: zmen-ma

# DBeaver na porte 3306. Účet má len SELECT nad archívom.
archive_readonly:
  user: dbeaver
  password: zmen-ma

# Servisné menu HMI. Prázdny reťazec znamená, že stačí Enter.
# session_secret podpisuje reláciu. Nahraď ho vlastným, napr. openssl rand -hex 32.
hmi:
  service_password: ""
  session_secret: "zmen-ma"

# Odosielateľ alarmových mailov. password je heslo aplikácie, nie heslo schránky.
smtp:
  host: smtp.example.com
  port: 587
  user: alarm@example.com
  password: zmen-ma
  from: alarm@example.com
