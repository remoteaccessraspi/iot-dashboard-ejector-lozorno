[Unit]
Description=IoT Current Loop Converter (ejector-lozorno)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/iot-dashboard-ejector-lozorno
ExecStart=/home/pi/iot-dashboard-ejector-lozorno/.venv/bin/python -u converter_db.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
