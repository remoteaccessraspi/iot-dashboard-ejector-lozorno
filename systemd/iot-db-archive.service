[Unit]
Description=IoT archive sync (RAM MariaDB to SD)
After=mariadb.service mariadb-hot.service iot-db-warm.service
Wants=mariadb.service mariadb-hot.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/iot-dashboard-ejector-lozorno
Environment=PYTHONPATH=/home/pi/iot-dashboard-ejector-lozorno
ExecStart=/home/pi/iot-dashboard-ejector-lozorno/.venv/bin/python -u iot_core/runners/archive_sync.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
